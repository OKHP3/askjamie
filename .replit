modules = ["web", "nodejs-24", "python-3.11"]
[agent]
expertMode = true
integrations = ["github:1.0.0"]

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "responsive-qa"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "site-audit"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/serve-site.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "responsive-qa"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node scripts/responsive-qa.mjs --static"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "site-audit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 scripts/audit-site.py --quiet"

[workflows.workflow.metadata]
isValidation = true

[[ports]]
localPort = 5000
externalPort = 80
exposeLocalhost = true

[deployment]
deploymentTarget = "static"
publicDir = "."

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 480000
