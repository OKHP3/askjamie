{
  "engines": {
    "node": "24.21.0"
  },
  "devDependencies": {
    "lighthouse": "13.5.0",
    "playwright": "1.64.1"
  },
  "scripts": {
    "validate": "python3 scripts/validate-site.py",
    "check:cache-bust": "python3 scripts/cache-bust.py --check",
    "check:links": "python3 scripts/check-links.py",
    "check:search-index": "python3 scripts/build-search-index.py --check",
    "check:stack": "python3 scripts/technology-audit.py --check",
    "audit:technologies": "python3 scripts/technology-audit.py",
    "test": "pytest",
    "qa:responsive": "node scripts/responsive-qa.mjs --base=http://127.0.0.1:5000",
    "qa:responsive-static": "node scripts/responsive-qa.mjs --static",
    "qa:experience": "node scripts/experience-qa.cjs",
    "audit": "python3 scripts/audit-site.py --quiet",
    "serve": "python3 scripts/serve-site.py"
  }
}
